# ProctoX backend env — copy to .env for local dev.
# Production (Render): set these in the dashboard / render.yaml instead.
# Never commit a real .env.

# --- Django core ---
# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
# Comma-separated, no spaces required. Render hostname is auto-accepted via
# RENDER_EXTERNAL_HOSTNAME, so this can stay empty on Render.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Production: Render injects DATABASE_URL (takes precedence when set).
# Local dev: leave DATABASE_URL empty and use DB_ENGINE=sqlite3 (default),
# or DB_ENGINE=postgresql + the DB_* vars below.
DATABASE_URL=
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# Production DB tuning
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Frontend origins (no trailing slash!) ---
# Local: the Vite dev server. Production: your Vercel URL, e.g.
# CORS_ALLOWED_ORIGINS=https://proctox.vercel.app
# CSRF_TRUSTED_ORIGINS=https://proctox.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# --- Media / file storage ---
# Local disk in DEBUG. In production set the CLOUDINARY_* trio so reference
# photos + proctoring thumbnails survive Render's ephemeral disk (free
# Cloudinary account is enough; thumbnails stay ≤ PROCTORING_SNAPSHOT_MAX_SIZE_MB).
MEDIA_ROOT=media
MEDIA_URL=/media/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Background workers (optional) ---
# Local dev: True (needs redis-server). Production free tier: False — the
# deadline is enforced lazily on every attempt request + the CRON-gated sweep.
CELERY_ENABLED=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Auto-submit sweep pinger ---
# Shared secret for POST /api/system/sweep/auto-submit/ (header X-CRON-SECRET
# or ?secret=). Generate: openssl rand -hex 32. Empty locks the endpoint (403).
CRON_SECRET=

# --- First admin (no Render Shell on free plan) ---
# python manage.py ensure_admin reads these (idempotent — skips if it exists).
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_USERNAME= (optional, defaults to email local-part)

# --- Proctoring ---
PROCTORING_SNAPSHOT_MAX_SIZE_MB=2
PROCTORING_DATA_RETENTION_DAYS=90

# --- Grading (stretch goal, PRD.md §10 — keep False unless approved) ---
# Enables keyword-overlap *suggestions* for short answers; never auto-applied.
AI_ASSIST_GRADING_ENABLED=False

# --- Production hardening (only applied when DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
