# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For local development, leave DB_ENGINE unset or set to 'sqlite3'
# For production/PostgreSQL, set DB_ENGINE=postgresql
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Settings (frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media/File Storage
MEDIA_ROOT=media
MEDIA_URL=/media/

# Celery Settings (for background workers)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Proctoring Settings
PROCTORING_SNAPSHOT_MAX_SIZE_MB=2
PROCTORING_DATA_RETENTION_DAYS=90

# Grading Settings (stretch goal, PRD.md §10 — keep False unless approved)
# Enables keyword-overlap *suggestions* for short answers; never auto-applied.
AI_ASSIST_GRADING_ENABLED=False
