# ProctoX frontend env — copy to .env for local dev.
# Production (Vercel): set VITE_API_BASE_URL in the project dashboard instead
# (no trailing slash on the /api path is required — include it).

# Local dev (Django runserver on :8000)
VITE_API_BASE_URL=http://localhost:8000/api

# Production example (Render backend — use YOUR service URL):
# VITE_API_BASE_URL=https://proctox-backend.onrender.com/api
